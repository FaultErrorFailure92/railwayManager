{
  "name": "railway-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && VITE_DEMO=1 vite build --outDir dist-demo",
    "preview": "vite preview",
    "sprites": "python3 tools/gen_sprites.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "node tools/balance.mjs",
    "perf": "node tools/perf.mjs",
    "atlas": "python3 tools/pack_atlas.py",
    "desktop:dev": "cargo tauri dev",
    "desktop:build": "cargo tauri build",
    "desktop:steam": "cargo tauri build --features steam",
    "steam:depot": "node tools/steam-depot.mjs"
  },
  "dependencies": {
    "@fontsource/vt323": "5.2.7",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "5.1.0"
  }
}
